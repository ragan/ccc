# Example configuration. Copy to .env (ignored by git) and adjust
# for local use — docker compose reads .env automatically and uses it
# to override the defaults in docker-compose.yml.
# Or run with one-off overrides: docker compose --env-file example.env up

# Grafana admin credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Host ports
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
